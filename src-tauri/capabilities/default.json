{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions for updater, process and opener plugins.",
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:default",
    "opener:default"
  ]
}
