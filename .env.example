DATABASE_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require"
DATABASE_POOL_SIZE="3"
STORE_RECORD_READ_MODE="auto"

# credits = SaaS 灵石计费；subscription = 一次性授权/本地部署，自带 AI Key，不扣灵石
APP_BILLING_MODE="credits"

