DATABASE_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require"
DATABASE_POOL_SIZE="3"
STORE_RECORD_READ_MODE="auto"

# credits = SaaS 灵石计费；subscription = 一次性授权/本地部署，自带 AI Key，不扣灵石
APP_BILLING_MODE="subscription"
APP_ACTIVATION_CODES="CUSTOMER-2026-DEMO"
# 如果不想把明文激活码放进配置，也可以改用 SHA-256 哈希，多个用英文逗号分隔
APP_ACTIVATION_CODE_HASHES=""
# 客户本地软件填写你的 Vercel 授权中心地址；授权中心自身留空
LICENSE_SERVER_URL="https://book-ybtm.vercel.app"

AI_PROVIDER_NAME=""
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
AI_TIMEOUT_MS="60000"

JOB_WORKER_TOKEN="change-me-to-a-long-random-secret"
ADMIN_EMAILS="admin@example.com"
