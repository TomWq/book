DATABASE_URL="file:./data/license-center.db"
APP_STORE_PATH="./data/app-db.json"
DATABASE_POOL_SIZE="3"
STORE_RECORD_READ_MODE="auto"

# cloud = Vercel/服务器上的授权中心与管理员后台；desktop = Electron 客户端
APP_RUNTIME="desktop"
# local = 服务器自带邮箱密码登录；auto = 有 Supabase 配置时优先使用 Supabase Auth
APP_AUTH_PROVIDER="local"

# 授权中心配置：在云端生成和校验授权码
APP_ACTIVATION_CODES="CUSTOMER-2026-DEMO"
# 如果不想把明文激活码放进配置，也可以改用 SHA-256 哈希，多个用英文逗号分隔
APP_ACTIVATION_CODE_HASHES=""

# Electron 客户端配置：桌面端填写你的 Vercel 授权中心地址；授权中心自身留空
LICENSE_SERVER_URL="https://book-fuzhu.edgeone.dev/"
LICENSE_SERVER_TIMEOUT_MS="30000"
# 国内网络访问 Vercel 不稳定时，桌面端可配置本机代理，例如 socks5h://127.0.0.1:10886
LICENSE_SERVER_PROXY=""

AI_PROVIDER_NAME=""
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
AI_TIMEOUT_MS="60000"

JOB_WORKER_TOKEN="change-me-to-a-long-random-secret"
ADMIN_EMAILS="admin@example.com"

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
