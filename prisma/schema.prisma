generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Bridge table for the first database migration slice.
/// It stores the existing application store as one durable database snapshot.
/// Later migrations can normalize this payload into projects, chapters,
/// templates, writing state, review reports and ai_jobs tables without
/// breaking the current product workflow.
model AppState {
  id        String   @id @default("default")
  payload   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// PostgreSQL-facing domain mirror for the current migration stage.
/// App code still reads the AppState snapshot, while this table exposes each
/// domain record with owner/project indexes so the next repository migration
/// can move reads away from the bridge safely.
model StoreRecord {
  id          String   @id
  entityType  String
  userId      String?
  ownerUserId String?
  projectId   String?
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entityType])
  @@index([userId])
  @@index([ownerUserId])
  @@index([projectId])
}

model Project {
  id           String      @id
  ownerUserId  String?
  name         String
  type         String
  description  String
  genre        String
  status       String
  createdAt    DateTime
  updatedAt    DateTime
  sourceTexts  SourceText[]
  chapters     Chapter[]
  chapterAnalyses ChapterAnalysis[]
  storyAnalyses StoryAnalysis[]
  templates    Template[]
  writingBibles WritingBible[]
  characterProfiles CharacterProfile[]
  foreshadowings Foreshadowing[]
  plotStates   PlotState[]
  writingTaskCards WritingTaskCard[]
  chapterDrafts ChapterDraft[]
  chapterLedgers ChapterLedger[]
  reviewReports ReviewReport[]
  editReports  EditReport[]
  aiJobs       AiJob[]
}

model SourceText {
  id         String   @id
  projectId  String
  title      String
  content    String
  sourceType String
  charCount  Int
  createdAt  DateTime
  updatedAt  DateTime
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapters   Chapter[]
}

model Chapter {
  id           String   @id
  projectId    String
  sourceTextId String
  chapterNumber Int
  title        String
  content      String
  charCount    Int
  orderIndex   Int
  createdAt    DateTime
  updatedAt    DateTime
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceText   SourceText @relation(fields: [sourceTextId], references: [id], onDelete: Cascade)
  analyses     ChapterAnalysis[]
}

model ChapterAnalysis {
  id             String   @id
  projectId      String
  chapterId      String
  summary        String
  mainEvent      String
  conflict       String
  pressurePoint  String
  payoff         String
  cliffhanger    String
  readerHook     String
  newInformation Json?
  newCharacters  Json?
  stateChanges   Json?
  entityRelations Json?
  pleasurePoints Json?
  createdAt      DateTime
  updatedAt      DateTime
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter        Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model StoryAnalysis {
  id                  String   @id
  projectId           String
  genre               String
  protagonistModel    String
  openingModel        String
  goldenFingerMechanism String
  villainFunction     String
  supportingRoles     String
  mapProgression      String
  usablePatterns      Json?
  avoidCopying        Json?
  openingHook         String
  mainLoop            String
  pacing              String
  topPleasureTypes    Json?
  formula             String
  migrationAdvice     String
  createdAt           DateTime
  updatedAt           DateTime
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templates           Template[]
}

model Template {
  id                  String   @id
  ownerUserId         String?
  sourceProjectId     String?
  sourceStoryAnalysisId String?
  name                String
  genre               String
  description         String
  openingHook         String
  mainLoop            String
  chapterPacing       String
  formula             String
  migrationAdvice     String
  protagonistModel    String
  goldenFinger        String
  usablePatterns      Json?
  avoidCopying        Json?
  tags                Json?
  createdAt           DateTime
  updatedAt           DateTime
  sourceProject       Project?       @relation(fields: [sourceProjectId], references: [id], onDelete: SetNull)
  sourceStoryAnalysis StoryAnalysis? @relation(fields: [sourceStoryAnalysisId], references: [id], onDelete: SetNull)
  outlines            Outline[]
}

model Outline {
  id                 String   @id
  templateId         String
  variables          Json
  titleOptions       Json?
  logline            String
  intro              String
  templateInheritance Json?
  variableMapping    Json?
  coreSellingPoints  Json?
  worldSetting       String
  protagonist        String
  characters         Json?
  first10Chapters    Json?
  first100Pacing     String
  foreshadowingPlan  Json?
  pleasureDistribution String
  createdAt          DateTime
  updatedAt          DateTime
  template           Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model WritingBible {
  id               String   @id
  projectId        String
  workType         String
  targetReader     String
  corePleasure     String
  protagonistDesire String
  worldRules       String
  goldenFingerRules String
  powerSystem      String
  narrativeTaboos  String
  immutableSettings String
  styleGuide       String
  createdAt        DateTime
  updatedAt        DateTime
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CharacterProfile {
  id                    String   @id
  projectId             String
  name                  String
  identity              String
  currentGoal           String
  longTermGoal          String
  secret                String
  relationshipToProtagonist String
  attitude              String
  abilityBoundary       String
  voice                 String
  knownInformation      String
  unknownInformation    String
  lastAppearance        String
  currentState          String
  createdAt             DateTime
  updatedAt             DateTime
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Foreshadowing {
  id                   String   @id
  projectId            String
  name                 String
  plantedChapter       String
  relatedCharacters    Json?
  relatedLocation      String
  status               String
  expectedRevealChapter String
  revealMethod         String
  hiddenInformation    String
  createdAt            DateTime
  updatedAt            DateTime
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PlotState {
  id                   String   @id
  projectId            String
  currentVolume        String
  currentMap           String
  mainGoal             String
  shortTermGoal        String
  currentStage         String
  currentEnemy         String
  unresolvedQuestions  Json?
  openThreads          Json?
  resolvedThreads      Json?
  nextMilestones       Json?
  nextStageGoal        String
  powerSystemState     String
  mapAndForces         String
  resourceState        String
  relationshipChanges  Json?
  createdAt            DateTime
  updatedAt            DateTime
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model WritingTaskCard {
  id                   String   @id
  projectId            String
  chapterNumber        Int
  title                String
  chapterGoal          String
  continuity           String
  mainPlotProgress     String
  requiredCharacters   Json?
  pleasurePoint        String
  foreshadowingTasks   Json?
  rulesNotToBreak      Json?
  endingHook           String
  status               String
  createdAt            DateTime
  updatedAt            DateTime
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  drafts               ChapterDraft[]
}

model ChapterDraft {
  id                   String   @id
  projectId            String
  taskCardId           String
  chapterNumber        Int
  title                String
  content              String
  status               String
  createdAt            DateTime
  updatedAt            DateTime
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskCard             WritingTaskCard @relation(fields: [taskCardId], references: [id], onDelete: Cascade)
  ledgers              ChapterLedger[]
  reviewReports        ReviewReport[]
}

model ChapterLedger {
  id                   String   @id
  projectId            String
  draftId              String
  chapterNumber        Int
  title                String
  events               Json?
  newCharacters        Json?
  newClues             Json?
  payoff               String
  cliffhanger          String
  stateChanges         Json?
  createdAt            DateTime
  updatedAt            DateTime
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  draft                ChapterDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

model ReviewReport {
  id                   String   @id
  projectId            String
  draftId              String
  chapterNumber        Int
  overall              String
  issues               Json?
  shouldUpdateState    Boolean
  stateUpdateSuggestions Json?
  createdAt            DateTime
  updatedAt            DateTime
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  draft                ChapterDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

model EditReport {
  id                   String   @id
  projectId            String
  draftId              String?
  mode                 String
  originalText         String
  aiFlavorSentences    Json?
  diagnosis            Json?
  revisedText          String
  createdAt            DateTime
  updatedAt            DateTime
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AiJob {
  id            String   @id
  userId        String?
  projectId     String?
  type          String
  status        String
  input         Json?
  output        Json?
  error         String?
  attempts      Int
  model         String?
  retryOfJobId  String?
  createdAt     DateTime
  updatedAt     DateTime
  startedAt     DateTime?
  finishedAt    DateTime?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AiSetting {
  id          String   @id @default("default")
  userId      String?
  profileName String?
  providerName String
  baseUrl      String
  apiKey       String
  model        String
  models       Json?
  active       Boolean?
  timeoutMs    Int
  updatedAt    DateTime @updatedAt
}

model User {
  id             String   @id
  email          String   @unique
  name           String
  passwordSalt   String
  passwordHash   String
  role           String
  plan           String?
  creditsBalance Int?
  aiBillingMarkup Float?
  aiBillingMinimum Int?
  aiTaskPricingOverrides Json?
  licenseCustomerId String?
  licenseCodeHash String?
  licenseActivatedAt DateTime?
  onboardingCompletedAt DateTime?
  createdAt      DateTime
  updatedAt      DateTime
  sessions       Session[]
}

model Session {
  id         String   @id
  userId     String
  token      String   @unique
  createdAt  DateTime
  expiresAt  DateTime
  lastSeenAt DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model CreditTransaction {
  id           String   @id
  userId       String
  type         String
  amount       Int
  balanceAfter Int
  reason       String
  relatedJobId String?
  orderId      String?
  createdAt    DateTime

  @@index([userId])
  @@index([relatedJobId])
}

model LicenseCode {
  id              String    @id
  codeHash        String    @unique
  codePreview     String
  customerName    String?
  customerContact String?
  status          String    @default("unused")
  maxActivations  Int       @default(1)
  activationCount Int       @default(0)
  machineHash     String?
  activatedAt     DateTime?
  lastVerifiedAt  DateTime?
  expiresAt       DateTime?
  disabledAt      DateTime?
  notes           String?
  createdAt       DateTime
  updatedAt       DateTime
  logs            LicenseActivationLog[]
}

model LicenseActivationLog {
  id            String   @id
  licenseCodeId String?
  codeHash      String
  machineHash   String?
  result        String
  reason        String
  clientName    String?
  createdAt     DateTime
  licenseCode   LicenseCode? @relation(fields: [licenseCodeId], references: [id], onDelete: SetNull)

  @@index([licenseCodeId])
  @@index([codeHash])
}
