{
  "name": "ai-novel-workbench",
  "private": true,
  "version": "1.0.12",
  "description": "面向网文作者的爆款拆解、模板迁移和长篇创作工作台",
  "author": "墨澜 · AI 网文写作助手",
  "scripts": {
    "dev": "APP_RUNTIME=cloud NEXT_PUBLIC_APP_RUNTIME=cloud next dev",
    "dev:public": "APP_RUNTIME=cloud NEXT_PUBLIC_APP_RUNTIME=cloud next dev",
    "dev:desktop": "APP_RUNTIME=desktop NEXT_PUBLIC_APP_RUNTIME=desktop next dev",
    "dev:trial-center": "APP_RUNTIME=cloud NEXT_PUBLIC_APP_RUNTIME=cloud DESKTOP_TRIAL_DURATION_MINUTES=2 DATABASE_URL=file:./data/trial-center.db APP_STORE_PATH=./data/trial-center.json next dev -p 3101",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "icons:generate": "node scripts/generate-desktop-icons.mjs",
    "tauri:prepare": "node scripts/tauri-prepare.mjs",
    "tauri:dev": "npm run build && npm run tauri:prepare && tauri dev",
    "tauri:dev:trial": "LICENSE_SERVER_URL=http://10.189.154.93:3000 npm run tauri:dev",
    "tauri:build": "node scripts/tauri-build.mjs",
    "tauri:build:mac:arm64": "node scripts/tauri-build.mjs --mac --arm64",
    "tauri:build:win:x64": "node scripts/tauri-build.mjs --win --x64",
    "release:tauri": "gh workflow run \"Tauri Release\" --ref main",
    "release:tauri:status": "gh run list --workflow \"Tauri Release\" --limit 5",
    "release:download": "node scripts/download-tauri-release.mjs",
    "downloads:publish": "node scripts/publish-downloads.mjs",
    "downloads:local": "node scripts/publish-downloads.mjs --local-only",
    "downloads:manifest": "node scripts/publish-downloads.mjs --manifest-only",
    "manual:build": "node scripts/build-user-manual.mjs",
    "deploy:server": "node scripts/deploy-server.mjs",
    "acceptance": "node scripts/acceptance-check.mjs",
    "acceptance:flow": "node scripts/main-flow-check.mjs",
    "worker": "node scripts/run-worker.mjs",
    "activation:reset": "node scripts/reset-local-activation.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xyflow/react": "^12.10.2",
    "better-sqlite3": "^12.10.0",
    "next": "^16.2.6",
    "node": "^22.18.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "socks-proxy-agent": "^10.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "sharp": "^0.34.5",
    "typescript": "^5.0.0"
  }
}
